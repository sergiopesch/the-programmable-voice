{
  "name": "the-programmable-voice",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive, evidence-led history of sound, music and the human voice.",
  "homepage": "https://the-programmable-voice.vercel.app",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sergiopesch/the-programmable-voice.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run narration:verify-build && npm run build:app",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "vitest run && npm run test:narration-job",
    "test:narration-job": "vitest run --config scripts/vitest.narration-job.config.ts",
    "test:e2e": "playwright test",
    "narration:compare-british-voices": "tsx scripts/generate-british-voice-comparison.ts",
    "narration:pilot": "tsx scripts/generate-narration.ts --pilot",
    "narration:approve-pilot": "tsx scripts/verify-narration.ts --approve-pilot",
    "narration:generate": "tsx scripts/generate-narration.ts",
    "narration:vercel-job": "tsx scripts/narration-vercel-job.ts",
    "narration:approve": "tsx scripts/verify-narration.ts --approve",
    "narration:verify": "tsx scripts/verify-narration.ts",
    "narration:verify-build": "tsx scripts/verify-narration.ts --lightweight",
    "check": "npm run lint && npm run test && npm run narration:verify && npm run build:app"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
